generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  ADMIN
  STOCK_CONTROLLER
  USER
}

enum OrganizationLevel {
  EXECUTIVE
  MANAGER
  SUPERVISOR
  STAFF
}

enum OrganizationTag {
  EXECUTIVE
  CONSULTANT
  BSD_MANAGER
  BSD_SUPERVISOR
  BSD_STAFF
  SC_MANAGER
  SCN_MANAGER
  S1_SUPERVISOR
  S1_STAFF
  N1_SUPERVISOR
  N1_STAFF
  C1_SUPERVISOR
  C1_STAFF
  DL_MANAGER
  DL_SUPERVISOR
  DL_STAFF
  EN_MANAGER
  CS_MANAGER
  CMS_SUPERVISOR
  CMS_STAFF
  SD_SUPERVISOR
  SD_STAFF
  PRT_SUPERVISOR
  PRT_STAFF
  LOCAL_SUPERVISOR
  LOCAL_STAFF
}

enum ProjectTag {
  LEAD_PROJECT
  TEAM_MEMBER
}

enum ProjectStatus {
  ACTIVE
  CLOSED
}

enum ProjectMemberTag {
  LEAD_PROJECT
  TEAM_MEMBER
}

enum StockControllerTag {
  HEAD_STOCK_CONTROLLER
  STOCK_CONTROLLER
}

enum AssetTrackMethod {
  SERIAL
  QUANTITY
}

enum AssetStatus {
  READY
  REQUEST
  BORROW
  USING
  SOLD
  FAIL
  LOST
  NEED_CHECK
}

enum AssetActionType {
  CREATE
  REQUEST_HOLD
  REQUEST_SUBMIT
  STATUS_CHANGE
  RETURN
  MARK_FAIL
  MARK_LOST
  MARK_NEED_CHECK
  ADJUST_QUANTITY
  IMPORT
}

enum TransactionType {
  BORROW
  USING
  SOLD
}

enum TransactionStatus {
  BORROWED
  RETURNED
  USING
  COMPLETED
}

enum TransactionWorkflowStatus {
  PENDING
  REJECTED
  CANCELLED
  IN_PROGRESS
  COMPLETED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CustomFieldDataType {
  TEXT
  NUMBER
  DROPDOWN
  BOOLEAN
}

enum MigrationStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum MigrationRowStatus {
  PENDING
  IMPORTED
  FAILED
  SKIPPED
  NEEDS_REVIEW
}

model User {
  id                       String                       @id @default(uuid()) @db.Uuid
  name                     String
  email                    String                       @unique
  ldapUsername             String?                      @unique @map("ldap_username")
  passwordHash             String?                      @map("password_hash")
  azureAdObjectId          String?                      @unique @map("azure_ad_object_id")
  position                 String?
  organizationLevel        OrganizationLevel?           @map("organization_level")
  organizationTag          OrganizationTag?             @map("organization_tag")
  projectTag               ProjectTag?                  @map("project_tag")
  stockControllerTag       StockControllerTag?          @map("stock_controller_tag")
  signatureDataUrl         String?                      @map("signature_data_url")
  signatureUploadedAt      DateTime?                    @map("signature_uploaded_at")
  signatureUploadedById    String?                      @map("signature_uploaded_by") @db.Uuid
  lastLoginAt              DateTime?                    @map("last_login_at")
  isActive                 Boolean                      @default(true) @map("is_active")
  createdAt                DateTime                     @default(now()) @map("created_at")
  updatedAt                DateTime                     @updatedAt @map("updated_at")
  roles                    UserRole[]
  organizationAssignments  UserOrganizationAssignment[]
  signatureUploadedBy      User?                        @relation("UserSignatureUploadedBy", fields: [signatureUploadedById], references: [id], onDelete: SetNull)
  uploadedSignatures       User[]                       @relation("UserSignatureUploadedBy")
  warehousePermissions     UserWarehousePermission[]
  requestLockedAssets      Asset[]                      @relation("AssetRequestLockedBy")
  createdAssets            Asset[]                      @relation("AssetCreatedBy")
  updatedAssets            Asset[]                      @relation("AssetUpdatedBy")
  statusHistories          AssetStatusHistory[]
  requestedTransactions    Transaction[]                @relation("TransactionRequestedBy")
  createdTransactions      Transaction[]                @relation("TransactionCreatedBy")
  returnedTransactionItems TransactionItem[]            @relation("TransactionItemReturnedBy")
  assetReservations        AssetReservation[]
  migrationBatches         MigrationBatch[]
  approvals                TransactionApproval[]
  ledProjects              Project[]                    @relation("ProjectLeadUser")
  projectMemberships       ProjectMember[]
  projectLeadChanges       ProjectLeadChange[]
  headControlledWarehouses AssetWarehouse[]             @relation("AssetWarehouseHeadStockController")

  @@map("users")
}

model UserOrganizationAssignment {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  organizationLevel OrganizationLevel @map("organization_level")
  organizationTag   OrganizationTag   @map("organization_tag")
  isPrimary         Boolean           @default(false) @map("is_primary")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationTag])
  @@index([organizationTag, isActive])
  @@index([userId, isPrimary])
  @@map("user_organization_assignments")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        RoleCode   @unique
  name        String
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AssetWarehouse {
  id                    String                    @id @default(uuid()) @db.Uuid
  code                  String                    @unique
  prefix                String                    @unique @map("warehouse_prefix")
  name                  String
  inventoryFamily       AssetTrackMethod          @default(SERIAL) @map("inventory_family")
  description           String?
  isActive              Boolean                   @default(true) @map("is_active")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  headStockControllerId String?                   @map("head_stock_controller_id") @db.Uuid
  headStockController   User?                     @relation("AssetWarehouseHeadStockController", fields: [headStockControllerId], references: [id], onDelete: SetNull)
  permissions           UserWarehousePermission[]
  categories            AssetCategory[]
  models                AssetModel[]
  assets                Asset[]

  @@index([headStockControllerId])
  @@map("asset_warehouses")
}

model UserWarehousePermission {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  warehouseId String         @map("warehouse_id") @db.Uuid
  canView     Boolean        @default(true) @map("can_view")
  canManage   Boolean        @default(false) @map("can_manage")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse   AssetWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([userId, warehouseId])
  @@index([warehouseId])
  @@map("user_warehouse_permissions")
}

model AssetCategory {
  id           String                     @id @default(uuid()) @db.Uuid
  warehouseId  String                     @map("warehouse_id") @db.Uuid
  name         String
  code         String?                    @map("category_code")
  description  String?
  isActive     Boolean                    @default(true) @map("is_active")
  createdAt    DateTime                   @default(now()) @map("created_at")
  updatedAt    DateTime                   @updatedAt @map("updated_at")
  warehouse    AssetWarehouse             @relation(fields: [warehouseId], references: [id])
  models       AssetModel[]
  types        AssetType[]
  customFields AssetCategoryCustomField[]

  @@unique([warehouseId, name])
  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@map("asset_categories")
}

model AssetType {
  id           String                     @id @default(uuid()) @db.Uuid
  categoryId   String                     @map("category_id") @db.Uuid
  name         String
  code         String?                    @map("type_code")
  trackMethod  AssetTrackMethod           @default(SERIAL) @map("track_method")
  description  String?
  isActive     Boolean                    @default(true) @map("is_active")
  createdAt    DateTime                   @default(now()) @map("created_at")
  updatedAt    DateTime                   @updatedAt @map("updated_at")
  category     AssetCategory              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  models       AssetModel[]
  customFields AssetCategoryCustomField[]

  @@unique([categoryId, name])
  @@unique([categoryId, code])
  @@index([categoryId])
  @@map("asset_types")
}

model AssetCategoryCustomField {
  id           String                  @id @default(uuid()) @db.Uuid
  categoryId   String                  @map("category_id") @db.Uuid
  assetTypeId  String?                 @map("asset_type_id") @db.Uuid
  key          String
  label        String
  dataType     CustomFieldDataType     @default(TEXT) @map("data_type")
  unit         String?
  placeholder  String?
  options      Json?
  isRequired   Boolean                 @default(false) @map("is_required")
  isSearchable Boolean                 @default(false) @map("is_searchable")
  isFilterable Boolean                 @default(false) @map("is_filterable")
  sortOrder    Int                     @default(0) @map("sort_order")
  isActive     Boolean                 @default(true) @map("is_active")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  category     AssetCategory           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  assetType    AssetType?              @relation(fields: [assetTypeId], references: [id], onDelete: SetNull)
  values       AssetCustomFieldValue[]

  @@unique([categoryId, key])
  @@index([categoryId])
  @@index([assetTypeId])
  @@map("asset_category_custom_fields")
}

model AssetCustomFieldValue {
  id           String                   @id @default(uuid()) @db.Uuid
  assetId      String                   @map("asset_id") @db.Uuid
  fieldId      String                   @map("field_id") @db.Uuid
  valueText    String?                  @map("value_text")
  valueNumber  Decimal?                 @map("value_number") @db.Decimal(18, 6)
  valueBoolean Boolean?                 @map("value_boolean")
  valueJson    Json?                    @map("value_json")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  asset        Asset                    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  field        AssetCategoryCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([assetId, fieldId])
  @@index([fieldId])
  @@map("asset_custom_field_values")
}

model AssetModel {
  id          String         @id @default(uuid()) @db.Uuid
  warehouseId String         @map("warehouse_id") @db.Uuid
  categoryId  String?        @map("category_id") @db.Uuid
  assetTypeId String?        @map("asset_type_id") @db.Uuid
  name        String
  brand       String?
  modelNo     String?        @map("model_no")
  partNo      String?        @map("part_no")
  typeName    String?        @map("type_name")
  description String?
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  warehouse   AssetWarehouse @relation(fields: [warehouseId], references: [id])
  category    AssetCategory? @relation(fields: [categoryId], references: [id])
  assetType   AssetType?     @relation(fields: [assetTypeId], references: [id])
  assets      Asset[]

  @@index([warehouseId])
  @@index([categoryId])
  @@index([assetTypeId])
  @@index([name])
  @@map("asset_models")
}

model Project {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  projectId    String?         @unique @map("project_id")
  status       ProjectStatus   @default(ACTIVE)
  description  String?
  leadUserId   String?         @map("lead_user_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  leadUser     User?           @relation("ProjectLeadUser", fields: [leadUserId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  leadChanges  ProjectLeadChange[]
  transactions Transaction[]

  @@index([status])
  @@index([leadUserId])
  @@map("projects")
}

model ProjectMember {
  id         String           @id @default(uuid()) @db.Uuid
  projectId  String           @map("project_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  projectTag ProjectMemberTag @map("project_tag")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, projectTag])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model ProjectLeadChange {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  changedById   String   @map("changed_by") @db.Uuid
  previousLeadIds Json?  @map("previous_lead_ids")
  nextLeadIds     Json   @map("next_lead_ids")
  createdAt     DateTime @default(now()) @map("created_at")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changedBy     User     @relation(fields: [changedById], references: [id])
  @@index([projectId, createdAt])
  @@map("project_lead_changes")
}

model Location {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  assets      Asset[]

  @@map("locations")
}

model Asset {
  id                String                  @id @default(uuid()) @db.Uuid
  assetModelId      String                  @map("asset_model_id") @db.Uuid
  warehouseId       String                  @map("warehouse_id") @db.Uuid
  locationId        String?                 @map("location_id") @db.Uuid
  serialNo          String?                 @unique @map("serial_no")
  assetNo           String?                 @map("asset_no")
  stockCode         String?                 @map("stock_code")
  status            AssetStatus
  note              String?
  specifications    Json                    @default("{}")
  imageRef          String?                 @map("image_ref")
  assetQuantity     Int                     @default(1) @map("asset_quantity")
  legacyQty         Int?                    @map("legacy_qty")
  legacyFg          Int?                    @map("legacy_fg")
  locationText      String?                 @map("location_text")
  sourceSystem      String?                 @map("source_system")
  sourceRecordId    String?                 @map("source_record_id")
  migrationBatchId  String?                 @map("migration_batch_id") @db.Uuid
  requestLockedById String?                 @map("request_locked_by") @db.Uuid
  requestLockedAt   DateTime?               @map("request_locked_at")
  isActive          Boolean                 @default(true) @map("is_active")
  createdById       String?                 @map("created_by") @db.Uuid
  updatedById       String?                 @map("updated_by") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  assetModel        AssetModel              @relation(fields: [assetModelId], references: [id])
  warehouse         AssetWarehouse          @relation(fields: [warehouseId], references: [id])
  location          Location?               @relation(fields: [locationId], references: [id])
  migrationBatch    MigrationBatch?         @relation(fields: [migrationBatchId], references: [id])
  requestLockedBy   User?                   @relation("AssetRequestLockedBy", fields: [requestLockedById], references: [id], onDelete: SetNull)
  createdBy         User?                   @relation("AssetCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?                   @relation("AssetUpdatedBy", fields: [updatedById], references: [id])
  statusHistories   AssetStatusHistory[]
  transactionItems  TransactionItem[]
  migrationRows     MigrationRow[]
  reservations      AssetReservation[]
  customFieldValues AssetCustomFieldValue[]

  @@index([warehouseId])
  @@index([status])
  @@index([locationId])
  @@index([assetModelId])
  @@index([sourceRecordId])
  @@index([stockCode])
  @@index([requestLockedById])
  @@map("assets")
}

model AssetReservation {
  id        String   @id @default(uuid()) @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  quantity  Int      @default(1)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assetId, userId])
  @@index([assetId])
  @@index([userId])
  @@map("asset_reservations")
}

model AssetStatusHistory {
  id               String          @id @default(uuid()) @db.Uuid
  assetId          String          @map("asset_id") @db.Uuid
  transactionId    String?         @map("transaction_id") @db.Uuid
  fromStatus       AssetStatus?    @map("from_status")
  toStatus         AssetStatus     @map("to_status")
  actionType       AssetActionType @map("action_type")
  note             String?
  previousQuantity Int?            @map("previous_quantity")
  newQuantity      Int?            @map("new_quantity")
  changedById      String          @map("changed_by") @db.Uuid
  changedAt        DateTime        @default(now()) @map("changed_at")
  asset            Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  transaction      Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  changedBy        User            @relation(fields: [changedById], references: [id])

  @@index([assetId])
  @@index([transactionId])
  @@index([toStatus])
  @@index([changedAt])
  @@index([changedById])
  @@map("asset_status_histories")
}

model Transaction {
  id                  String                    @id @default(uuid()) @db.Uuid
  transactionNo       String?                   @unique @map("transaction_no")
  sourceTransactionId String?                   @map("source_transaction_id") @db.Uuid
  type                TransactionType
  status              TransactionStatus
  workflowStatus      TransactionWorkflowStatus @default(COMPLETED) @map("workflow_status")
  purpose             String
  note                String?
  documentRef         String?                   @map("document_ref")
  requestDate         DateTime                  @default(now()) @map("request_date")
  dueDate             DateTime?                 @map("due_date")
  internalRequest     Boolean                   @default(false) @map("internal_request")
  serviceRequest      Boolean                   @default(false) @map("service_request")
  projectRequest      Boolean                   @default(false) @map("project_request")
  soldPrice           Decimal?                  @map("sold_price") @db.Decimal(12, 2)
  projectId           String?                   @map("project_id") @db.Uuid
  requestedById       String                    @map("requested_by") @db.Uuid
  createdById         String                    @map("created_by") @db.Uuid
  returnedAt          DateTime?                 @map("returned_at")
  completedAt         DateTime?                 @map("completed_at")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  requestedBy         User                      @relation("TransactionRequestedBy", fields: [requestedById], references: [id])
  createdBy           User                      @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  sourceTransaction   Transaction?              @relation("TransactionSource", fields: [sourceTransactionId], references: [id], onDelete: SetNull)
  project             Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  derivedTransactions Transaction[]             @relation("TransactionSource")
  items               TransactionItem[]
  statusHistories     AssetStatusHistory[]
  approvals           TransactionApproval[]

  @@index([type])
  @@index([status])
  @@index([workflowStatus])
  @@index([sourceTransactionId])
  @@index([projectId])
  @@index([requestedById])
  @@index([createdById])
  @@index([dueDate])
  @@index([requestDate])
  @@map("transactions")
}

model TransactionItem {
  id                String       @id @default(uuid()) @db.Uuid
  transactionId     String       @map("transaction_id") @db.Uuid
  assetId           String       @map("asset_id") @db.Uuid
  fromStatus        AssetStatus? @map("from_status")
  toStatus          AssetStatus  @map("to_status")
  requestedQuantity Int          @default(1) @map("requested_quantity")
  note              String?
  resolvedStatus    AssetStatus? @map("resolved_status")
  resolutionNote    String?      @map("resolution_note")
  soldPrice         Decimal?     @map("sold_price") @db.Decimal(12, 2)
  returnedAt        DateTime?    @map("returned_at")
  returnedById      String?      @map("returned_by") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  transaction       Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  asset             Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  returnedBy        User?        @relation("TransactionItemReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)

  @@unique([transactionId, assetId])
  @@index([assetId])
  @@index([transactionId])
  @@index([returnedById])
  @@index([resolvedStatus])
  @@map("transaction_items")
}

model TransactionApproval {
  id                        String         @id @default(uuid()) @db.Uuid
  transactionId             String         @map("transaction_id") @db.Uuid
  userId                    String?        @map("user_id") @db.Uuid
  stepSequence              Int            @map("approval_step_sequence")
  requiredTag               String         @map("approval_required_tag")
  approverNameSnapshot      String?        @map("approver_name_snapshot")
  approverTagSnapshot       String?        @map("approver_tag_snapshot")
  approverSignatureSnapshot String?        @map("approver_signature_snapshot")
  actedAt                   DateTime?      @map("approval_acted_at")
  comment                   String?        @map("approval_comment")
  status                    ApprovalStatus @default(PENDING) @map("approval_status")
  createdAt                 DateTime       @default(now()) @map("created_at")
  updatedAt                 DateTime       @updatedAt @map("updated_at")
  transaction               Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user                      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([userId])
  @@index([status])
  @@index([stepSequence])
  @@map("transaction_approvals")
}

model MigrationBatch {
  id           String          @id @default(uuid()) @db.Uuid
  sourceSystem String          @default("SharePoint") @map("source_system")
  fileName     String?         @map("file_name")
  status       MigrationStatus
  totalRows    Int             @default(0) @map("total_rows")
  successRows  Int             @default(0) @map("success_rows")
  failedRows   Int             @default(0) @map("failed_rows")
  createdById  String          @map("created_by") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")
  completedAt  DateTime?       @map("completed_at")
  createdBy    User            @relation(fields: [createdById], references: [id])
  rows         MigrationRow[]
  assets       Asset[]

  @@map("migration_batches")
}

model MigrationRow {
  id               String             @id @default(uuid()) @db.Uuid
  migrationBatchId String             @map("migration_batch_id") @db.Uuid
  rowNumber        Int                @map("row_number")
  rawData          Json               @map("raw_data")
  mappedData       Json?              @map("mapped_data")
  status           MigrationRowStatus
  errorMessage     String?            @map("error_message")
  assetId          String?            @map("asset_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  migrationBatch   MigrationBatch     @relation(fields: [migrationBatchId], references: [id], onDelete: Cascade)
  asset            Asset?             @relation(fields: [assetId], references: [id])

  @@index([migrationBatchId])
  @@index([assetId])
  @@map("migration_rows")
}
