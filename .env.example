DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stock_management?schema=public"
# Optional: override the Thai font files used when rendering transaction PDFs.
THAI_PDF_FONT_PATH="C:\\Windows\\Fonts\\LeelawUI.ttf"
THAI_PDF_FONT_BOLD_PATH="C:\\Windows\\Fonts\\leelawdb.ttf"
APP_URL="http://localhost:3000"
AUTH_SECRET="change-me-before-production"
NODE_ENV="development"
MAX_IMPORT_FILE_SIZE="10485760"
LDAP_URL="ldaps://directory.example.com:636"
LDAP_DOMAIN="example.com"
LDAP_BASE_DN="DC=example,DC=com"
LDAP_USER_SEARCH_BASE="OU=Users,DC=example,DC=com"
LDAP_CA_CERT_PATH=""
LDAP_ALLOW_INSECURE="false"
LDAP_TIMEOUT_MS="5000"
LDAP_CONNECT_TIMEOUT_MS="5000"
LDAP_VERIFY_BIND_DN="readonly-account@example.com"
LDAP_VERIFY_BIND_PASSWORD=""
AUTH_TRUST_PROXY="false"
